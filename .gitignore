# Ignore ad-hoc local scratch files, but keep the tracked model verifier.
# Without the negation, scripts/verify-model.cjs never shipped and existed only
# on one machine, where it silently rotted.
verify*
!scripts/verify-model.cjs
!scripts/verify-packaged-assets.cjs
*:Zone.Identifier

# One-off image optimisation scratch (PIL palettes, comparison renders).
# These are personal tooling at the repo root, not part of the app. The
# project itself is JS/TS, so no root-level Python is expected to ship.
/*.py
/_imgtest/
