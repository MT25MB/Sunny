{
  "name": "sunny-desktop",
  "private": true,
  "version": "1.5.13",
  "description": "A friendly, accessible AI desktop assistant designed to help seniors navigate computers easily using voice and text.",
  "main": "src/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "lint": "eslint .",
    "test": "node --test tests/security-regression.test.cjs tests/ci-screenshots.test.cjs tests/ci-contrast.test.cjs tests/ci-assets.test.cjs tests/ci-signing.test.cjs tests/ci-assets-paths.test.cjs tests/window-state.test.cjs tests/rendering-regression.test.cjs tests/download-links.test.cjs tests/window-behaviour.test.cjs",
    "verify": "npm run typecheck && npm run typecheck:electron && npm run lint && npm test && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:electron": "tsc --noEmit -p tsconfig.electron.json",
    "verify:model": "electron scripts/verify-model.cjs",
    "verify:assets": "node scripts/verify-packaged-assets.cjs",
    "check:rendering": "node scripts/check-rendering.cjs",
    "check:microphone": "node scripts/check-microphone.cjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:win": "electron-forge make --platform win32",
    "package:mac": "electron-forge make --platform darwin",
    "package:linux": "electron-forge make --platform linux",
    "premake": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@nut-tree-fork/provider-interfaces": "^4.2.6",
    "@nut-tree-fork/shared": "^4.2.6",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron/asar": "^4.3.1",
    "@eslint/js": "^9.9.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "electron": "^45.1.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "optionalDependencies": {
    "@electron-forge/maker-deb": "^8.0.1"
  },
  "overrides": {
    "file-type": "^21.3.1"
  }
}
