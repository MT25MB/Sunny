{
  "name": "sunny-desktop",
  "private": true,
  "version": "1.2.5",
  "description": "A friendly, accessible AI desktop assistant designed to help seniors navigate computers easily using voice and text.",
  "main": "src/electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "electron": "electron .",
    "lint": "eslint .",
    "test": "node --test tests/security-regression.test.cjs",
    "check:syntax": "node scripts/check-syntax.mjs",
    "verify:vision": "node scripts/verify-vision.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:syntax && npm test && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "package:win": "electron-forge make --platform win32",
    "package:mac": "electron-forge make --platform darwin",
    "package:linux": "electron-forge make --platform linux"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@eslint/js": "^9.9.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.18",
    "electron": "^44.7.0",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^7.3.7"
  },
  "optionalDependencies": {
    "@electron-forge/maker-deb": "^8.0.1"
  }
}