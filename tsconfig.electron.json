{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "noEmit": true,
    // We want to catch real type errors (wrong API shapes, missing properties)
    // not force a full type-annotation migration on legacy JS.
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/electron/*.cjs",
    "src/main/security/*.cjs"
  ],
  "exclude": ["node_modules", "dist", "out"]
}